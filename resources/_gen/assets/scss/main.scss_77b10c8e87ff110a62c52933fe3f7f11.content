:root{--color-primary:#2563eb;--color-accent:#0ea5e9;--color-background:#ffffff;--color-surface:#f8fafc;--color-text:#1e293b;--color-muted:#64748b;--color-border:#e2e8f0;--sidebar-width:280px;--header-height:64px}[data-theme=dark]{--color-background:#0f172a;--color-surface:#1e293b;--color-text:#f8fafc;--color-muted:#94a3b8;--color-border:#334155}*{box-sizing:border-box}body{margin:0;font-family:-apple-system,BlinkMacSystemFont,segoe ui,Roboto,helvetica neue,Arial,sans-serif;background-color:var(--color-background);color:var(--color-text);line-height:1.5;transition:background-color .3s ease,color .3s ease}a{color:var(--color-primary);text-decoration:none}a:hover{text-decoration:underline}.btn-icon{background:0 0;border:none;padding:.5rem;cursor:pointer;color:var(--color-text);border-radius:.375rem;display:flex;align-items:center;justify-content:center}.btn-icon:hover{background-color:var(--color-surface)}.header{position:fixed;top:0;left:0;right:0;height:var(--header-height);background-color:var(--color-background);border-bottom:1px solid var(--color-border);z-index:1000;display:flex;align-items:center;padding:0 1.5rem}.logo-text{font-weight:700;font-size:1.25rem;color:var(--color-primary)}.main-container{display:flex;padding-top:var(--header-height);min-height:100vh}.sidebar{width:var(--sidebar-width);height:calc(100vh - var(--header-height));position:fixed;left:0;top:var(--header-height);border-right:1px solid var(--color-border);background-color:var(--color-surface);overflow-y:auto;padding:1.5rem;transition:transform .3s ease}.sidebar-list{list-style:none;padding:0;margin:0}.sidebar-link{display:block;padding:.5rem 0;color:var(--color-text);font-size:.875rem}.sidebar-link:hover{color:var(--color-primary);text-decoration:none}.sidebar-link.active{color:var(--color-primary);font-weight:600}.content-area{flex:1;margin-left:var(--sidebar-width);padding:2rem;max-width:100%}.docs-content{max-width:800px;margin:0 auto}.muted{color:var(--color-muted);font-size:.75rem}@media(max-width:768px){.sidebar{transform:translateY(100%);width:100%;left:0;right:0;bottom:0;top:auto;height:80vh;border-right:none;border-top:1px solid var(--color-border);z-index:2000;border-radius:1rem 1rem 0 0}.sidebar.active{transform:translateY(0)}.content-area{margin-left:0;padding:1.5rem}.md\:hidden{display:flex}}@media(min-width:769px){.md\:hidden{display:none}}